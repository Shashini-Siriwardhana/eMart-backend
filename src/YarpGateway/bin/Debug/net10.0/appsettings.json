{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Clusters": {
      "products": {
        "Destinations": {
          "ProductsService": {
            "Address": "http://localhost:5266/"
          }
        }
      },
      "carts": {
        "Destinations": {
          "CartsService": {
            "Address": "http://localhost:5082/"
          }
        }
      },
      "order": {
        "Destinations": {
          "OrderService": {
            "Address": "http://localhost:5274/"
          }
        }
      },
      "payments": {
        "Destinations": {
          "PaymentsService": {
            "Address": "http://localhost:5094/"
          }
        }
      },
      "identity": {
        "Destinations": {
          "IdentityService": {
            "Address": "http://localhost:5088/"
          }
        }
      }
    },
    "Routes": {
      "products-route": {
        "ClusterId": "products",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "carts-route": {
        "ClusterId": "carts",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        }
      },
      "order-route": {
        "ClusterId": "order",
        "Match": {
          "Path": "/api/order/{**catch-all}"
        }
      },
      "payments-route": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }
      },
      "identity-route": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      }
    }
  }
}
